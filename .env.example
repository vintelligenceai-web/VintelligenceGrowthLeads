# Copy this file to ".env" and fill it in. Never share or commit .env.
# Use the mailbox on your separate outreach domain (see PLAYBOOK.md, section 3).

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@your-outreach-domain.com
SMTP_PASS=app-password-here

IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=you@your-outreach-domain.com
IMAP_PASS=app-password-here
